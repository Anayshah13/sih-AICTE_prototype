flowchart LR
    subgraph USER["User Layer"]
        DASH[Institution<br/>Dashboard]
        OFFICER[AICTE Officer<br/>Console]
        CHAT[Chatbot<br/>RAG over APH]
    end
    subgraph ORCH["Orchestrator"]
        ORCH_CORE[LangGraph<br/>State Machine]
    end
    subgraph AGENTS["6 AI Agents"]
        DOC[Doc Verifier<br/>Gemma 27B]
        COMP[Compliance Checker<br/>Qwen 72B]
        EVC[EVC Video Analyst<br/>YOLO+CLIP]
        FRAUD[Fraud Detector<br/>Gemma 27B]
        RES[Resource Allocator<br/>Algorithm]
        OMBUD[Ombudsperson Matcher<br/>BGE-M3]
    end
    subgraph TOOLS["Tool Registry (FastAPI)"]
        KG_T[KG_Query - SPARQL]
        OCR_T[OCR_Tool]
        GPS_T[GPS_Verify]
        EXT_T[External APIs<br/>Land/Fire/NIRF]
        SENSOR_T[Sensor_Query]
    end
    subgraph KNOW["Knowledge Layer"]
        KG[APH Knowledge Graph<br/>RDF/OWL + SPARQL]
        VS[Vector Store<br/>pgvector + HNSW]
    end
    subgraph MODELS["Model Layer - vLLM On-Prem"]
        QWEN[Qwen 72B]
        GEMMA[Gemma 27B/9B]
        YOLO[YOLOv8 + CLIP]
        BGE[BGE-M3]
    end
    subgraph SENSOR["Sensor Layer (On-Demand)"]
        SENSE[LoRaWAN mmWave<br/>People Counter]
        TSDB[TimescaleDB]
    end

    USER --> ORCH
    ORCH --> AGENTS
    AGENTS --> TOOLS
    TOOLS --> KNOW
    TOOLS --> SENSOR
    AGENTS --> MODELS

