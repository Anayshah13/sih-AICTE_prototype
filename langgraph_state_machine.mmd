stateDiagram-v2
    direction TB
    [*] --> ApplicationSubmitted
    ApplicationSubmitted --> DocumentVerifier
    DocumentVerifier --> DeficiencyNotice : verification fails
    DocumentVerifier --> ComplianceChecker : success
    ComplianceChecker --> DeficiencyList : non-compliant
    ComplianceChecker --> FraudDetector : compliant or fixable
    FraudDetector --> ManualReview : high risk
    FraudDetector --> ARMeasure : needs dimension tracking
    FraudDetector --> EVCReview : low risk
    ARMeasure --> EVCReview : ARCore lengths stored
    EVCReview --> PhysicalEVC : anomalies detected
    EVCReview --> ResourceAllocator : clean or verified
    ResourceAllocator --> FinalRecommendation : evaluators assigned
    FinalRecommendation --> HumanOfficerReview
    HumanOfficerReview --> OverrideLogged : officer overrides
    HumanOfficerReview --> DecisionAnchored : officer accepts
    OverrideLogged --> EventEmitted
    DecisionAnchored --> EventEmitted
    EventEmitted --> BlockchainAnchor : hash the step
    BlockchainAnchor --> [*]
    DeficiencyNotice --> [*]
    DeficiencyList --> [*]
    ManualReview --> [*]
    PhysicalEVC --> [*]

    classDef terminal fill:#3A2030,color:#FFFFFF,stroke:#8A5468,stroke-width:1.5px
    classDef review fill:#1B6B7A,color:#FFFFFF,stroke:#0D3A42,stroke-width:1.5px
    classDef normal fill:#233043,color:#FFFFFF,stroke:#7FA3C0,stroke-width:1.5px

    class DeficiencyNotice,DeficiencyList,ManualReview,PhysicalEVC terminal
    class HumanOfficerReview,FinalRecommendation review
    class ApplicationSubmitted,DocumentVerifier,ComplianceChecker,FraudDetector,ARMeasure,EVCReview,ResourceAllocator,OverrideLogged,DecisionAnchored,EventEmitted,BlockchainAnchor normal
