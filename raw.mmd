%%{init: {'theme':'base', 'themeVariables': {
  'primaryColor': '#1B6B7A',
  'primaryTextColor': '#FFFFFF',
  'primaryBorderColor': '#0D3A42',
  'lineColor': '#B0BEC5',
  'textColor': '#FFFFFF',
  'fontSize': '15px',
  'clusterBkg': '#0F1A26',
  'clusterBorder': '#4A5D6E',
  'edgeLabelBackground':'#0F1A26'
}}}%%
graph LR
    subgraph USERS["Users"]
        U1[Institution<br/>Dashboard]
        U2[AICTE Officer<br/>Console]
        U3[Chatbot]
    end
    subgraph APP["Application Layer"]
        ORCH[Orchestrator<br/>LangGraph + Outbox]
        A1[6 AI Agents]
        TOOLS[Tool Registry]
        NEXT[Web Frontend]
    end
    subgraph BUS["Event Bus"]
        KAFKA[Kafka<br/>6 topics, Avro]
    end
    subgraph CLOUD_DATA["Cloud Data"]
        S3[Document Store]
        PGV[Vector Store]
        REDIS[Cache]
        ES[Search Index]
        RDS[Relational DB<br/>non-PII]
    end
    subgraph ONPREM_DATA["On-Prem"]
        PII[PII Database<br/>encrypted]
        VLLM[LLM Serving<br/>Qwen + Gemma + BGE]
        JENA[Knowledge Graph<br/>Jena Fuseki]
        TSDB[Sensor DB<br/>TimescaleDB]
    end
    subgraph SENSOR_L["Sensor Layer - On-Demand"]
        SENSE[LoRaWAN mmWave<br/>People Counter]
    end

    U1 --> ORCH
    U2 --> ORCH
    U3 --> ORCH
    ORCH --> NEXT
    ORCH --> A1
    A1 --> TOOLS
    ORCH --> KAFKA
    A1 --> KAFKA
    KAFKA --> ES
    A1 -.->|API| VLLM
    A1 -.->|SPARQL| JENA
    A1 -.->|queries| PII
    A1 -.->|queries| TSDB
    A1 --> S3
    A1 --> PGV
    A1 --> REDIS
    SENSE -.->|on-demand| TSDB

    classDef userNode fill:#1A2E45,color:#FFFFFF,stroke:#8FB3D9,stroke-width:1.5px
    classDef appNode fill:#1B6B7A,color:#FFFFFF,stroke:#0D3A42,stroke-width:1.5px
    classDef busNode fill:#2E3B4E,color:#FFFFFF,stroke:#7FA3C0,stroke-width:1.5px
    classDef cloudNode fill:#1E4550,color:#FFFFFF,stroke:#4FA8BD,stroke-width:1.5px
    classDef onpremNode fill:#162235,color:#FFFFFF,stroke:#4A5D6E,stroke-width:1.5px
    classDef sensorNode fill:#1A3A3A,color:#FFFFFF,stroke:#4FA88A,stroke-width:1.5px

    class U1,U2,U3 userNode
    class ORCH,A1,TOOLS,NEXT appNode
    class KAFKA busNode
    class S3,PGV,REDIS,ES,RDS cloudNode
    class PII,VLLM,JENA,TSDB onpremNode
    class SENSE sensorNode

    style USERS fill:#0F1A26,color:#FFFFFF,stroke:#8FB3D9,stroke-width:2px
    style APP fill:#1B6B7A,color:#FFFFFF,stroke:#0D3A42,stroke-width:2px
    style BUS fill:#2E3B4E,color:#FFFFFF,stroke:#7FA3C0,stroke-width:2px
    style CLOUD_DATA fill:#1E4550,color:#FFFFFF,stroke:#4FA8BD,stroke-width:2px
    style ONPREM_DATA fill:#162235,color:#FFFFFF,stroke:#4A5D6E,stroke-width:2px
    style SENSOR_L fill:#1A3A3A,color:#FFFFFF,stroke:#4FA88A,stroke-width:2px
